{
  "name": "bandcamp-lyrics-scrape",
  "version": "1.0.0",
  "description": "Scrape the discography, track list and lyrics of a Bandcamp artist into JSON",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bandcamp-lyrics-scrape": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvelazquez/bandcamp-lyrics-scrape.git"
  },
  "keywords": [
    "bandcamp",
    "lyrics",
    "scraper",
    "cli"
  ],
  "author": "Leonardo Velazquez",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
